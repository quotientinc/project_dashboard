# syntax=docker/dockerfile:1
FROM python:3.13-slim

WORKDIR /app

RUN \
  apt-get update && \
  apt-get install -y \
    curl \
    && \
  rm -rf /var/lib/apt/lists/*

COPY streamlit-app/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY streamlit-app/app.py ./
COPY streamlit-app/pages/ ./pages/
COPY streamlit-app/utils/ ./utils/
COPY streamlit-app/components/ ./components/
COPY streamlit-app/.streamlit/ ./.streamlit/

RUN mkdir -p data logs

# Non-root user for security
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

VOLUME /app/data
VOLUME /app/logs

EXPOSE 8501/tcp

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health

CMD [ "streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", "--browser.gatherUsageStats=false" ]
