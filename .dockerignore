# Version control
.git
.github

# Python artifacts
__pycache__
*.pyc
.venv
venv

# Node artifacts (frontend deps rebuilt inside container)
node_modules
frontend/node_modules

# IDE and editor
.idea
.vscode

# AI tooling
.claude

# Runtime data (mounted as volumes, not baked in)
data/
logs/
*.db
*.sqlite
*.sqlite3

# Documentation and samples
docs/
sample-data/

# Environment and secrets
.env
.env.*

# Docker context (avoid recursive copy)
.dockerignore

# Temporary files
*.tmp
*.bak
